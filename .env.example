# Postgres
POSTGRES_USER=olho
POSTGRES_PASSWORD=olho_secret
POSTGRES_DB=olho_nolance
DATABASE_URL=postgresql+psycopg://olho:olho_secret@postgres:5432/olho_nolance

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_HOURS=72
SUPERADMIN_USER=superadmin
SUPERADMIN_PASSWORD=ancora

# Internal
MEDIA_INTERNAL_URL=http://media:8001
MEDIA_INTERNAL_TOKEN=media-internal-secret
API_INTERNAL_URL=http://api:8000
VIDEOS_PATH=/data/videos
ADS_PATH=/data/ads
BUFFERS_PATH=/data/buffers

# Web → API (browser-facing)
VITE_API_URL=http://localhost:8000
VITE_MEDIA_URL=http://localhost:8001

# Web host port is 3080 (see docker-compose). Container still listens on 8080.

# Media / desempenho
STREAM_MODE=auto
CLIP_ENCODER=auto
CLIP_RENDER_WORKERS=0
# Buffer do replay em RAM (~40 MB por câmera)
BUFFERS_RAM=1g

# Placa NVIDIA (NVENC) para montar os lances — descomente se o servidor tiver GPU NVIDIA
# COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml
# COMPOSE_PATH_SEPARATOR=;

# Cloudflare Tunnel: acrescente ;docker-compose.tunnel.yml ao COMPOSE_FILE e informe o token.
# No painel da Cloudflare, o Public Hostname deve apontar para http://web:8080
# CLOUDFLARE_TUNNEL_TOKEN=
